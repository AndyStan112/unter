# Copy to .env, supply your API key, then run the initialization command in README.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
AGENT_MODE=live
# These are generated only when absent. Existing local values are reused.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SERVICE_USERNAME=unter-service
SERVICE_PASSWORD=
# Read-only login for the MCP server: core refuses it for anything but GET.
READER_USERNAME=unter-reader
READER_PASSWORD=
POSTGRES_PASSWORD=
CORE_DB_PASSWORD=
AGENT_DB_PASSWORD=
ACTIVITY_DB_PASSWORD=
RABBITMQ_PASSWORD=
MAX_DAILY_RUNS=30
# Report emails (mailer). Empty SMTP_HOST: reports are stored but not emailed.
# compose.dev.yaml points the mailer at Mailpit instead (http://localhost:8025).
SMTP_HOST=
SMTP_PORT=587
# starttls (default), ssl (usually port 465) or none (local catcher only)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Unter reports <reports@example.com>
